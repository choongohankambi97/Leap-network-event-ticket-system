# ============================================================
# LEAP Networks – Founders Connect Ticketing System
# .gitignore
# ============================================================

# ---- Dependencies (All workspaces & packages) ----
node_modules/
**/node_modules/
.pnp
.pnp.js

# ---- Environment & Secrets (NEVER commit these) ----
.env
.env.*
!.env.example
!**/.env.example
backend/.env
backend/.env.*
frontend/.env.local
frontend/.env.production
frontend/.env.*

# ---- Build outputs & caches ----
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/
.cache/
**/.cache/
*.tsbuildinfo
next-env.d.ts

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- OS / Editor files ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Deployment & Cloud tool caches ----
.vercel/
*.local


.vercel
.env*
