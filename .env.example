# ========================================================
# LEAP Networks - Founders Connect Ticketing System
# Environment Variables Example
# ========================================================

# --- Backend Server Configuration ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Lipila Payment Gateway (https://docs.lipila.io/) ---
# Obtain API key from https://dashboard.lipila.dev (Sandbox) or https://dashboard.lipila.io (Production)
LIPILA_API_KEY=your_lipila_api_key_here
LIPILA_BASE_URL=https://api.lipila.dev/api/v1
LIPILA_WEBHOOK_SECRET=your_lipila_webhook_secret_here
LIPILA_CALLBACK_URL=https://leap-network-event-ticket-system-production.up.railway.app/api/webhooks/lipila

# --- Ticket Security & QR Salt ---
TICKET_SECRET=leap_founders_connect_2026_salt_token

# --- Developer Sandbox Mode ---
# Automatically enables simulated sandbox callbacks if no LIPILA_API_KEY is provided
SIMULATE_LIPILA_SANDBOX=true

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=https://leap-network-event-ticket-system-production.up.railway.app/api

